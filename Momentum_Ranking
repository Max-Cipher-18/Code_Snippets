/**
 * Volatility-adjusted momentum ranking - the project owner's own source
 * formula (a DIY retail-investor risk-adjusted momentum score), computed
 * as TWO fully independent tables on the same sheet, side by side (a
 * 1-column gap between them), each sorted descending by its own rank:
 *
 *   Long table:  Long_Momentum_Score  = ( (6M return / stdDev of daily
 *                returns over 6M) + (12M return / stdDev of daily returns
 *                over 12M) ) / 2
 *   Short table: Short_Momentum_Score = ( (1M return / stdDev of daily
 *                returns over 1M) + (3M return / stdDev of daily returns
 *                over 3M) ) / 2
 *
 * "Independent" matters: each table ranks only the symbols that have
 * enough history/real volatility for ITS OWN pair of windows - a symbol
 * can qualify for one table and not the other (e.g. a recent listing with
 * 90 days of history fails the Long table's 252-trading-day requirement
 * but can still rank in the Short table). One symbol's Long result never
 * gates whether it appears in the Short table or vice versa.
 *
 * Action is a zone read off each table's own Rank, with no Held/hysteresis
 * state (per the project owner's explicit choice - the column list given
 * for both tables has no Held column): BUY if Rank<=rankBuyThreshold(30),
 * SELL if Rank>rankSellThreshold(60), blank in between (not a fresh buy,
 * not flagged to avoid/exit either).
 *
 * Deliberately NOT part of the automated schedule (automation.gs) or the
 * Technical Analysis batch/trigger loop, per the project owner's explicit
 * instruction - its own menu item, own sheet, run manually (a monthly
 * rebalance cadence, not multiple-times-a-day). Independently fetches each
 * symbol's own price history rather than reading Technical-Analysis, which
 * only stores derived indicators (RSI, MACD, etc.), never raw closes - same
 * fetchHistoricalBatch_ Technical Analysis itself uses.
 *
 * BATCHED across time-driven triggers (rankRunBatch, below), same
 * scheduler-free continuation pattern Technical Analysis uses
 * (ta_batch_service.gs's taRunBatch/taCreateWorkerTrigger_) - a real run
 * was killed by Apps Script's "Exceeded maximum execution time" doing the
 * full-universe fetch synchronously in one execution, the exact failure
 * TA's batching already exists to prevent. RUN_BUILD_MOMENTUM_RANK_PLAN
 * (Code.gs) only starts the run and returns immediately (check
 * Momentum-Log for progress and the final MOMENTUM_RANK_PLAN_DONE line) -
 * it does not block until the sheet is written. Since scoring both tables'
 * Rank/Action needs every symbol's result first (unlike TA, where each
 * symbol's output row is independent and gets written immediately), each
 * wave's scored/unranked entries accumulate in CacheService
 * (rankCacheSaveAccumulators_/rankCacheLoadAccumulators_) across however
 * many worker executions the full symbol list needs, and the two tables
 * are only sorted/ranked/written once the last symbol has been scored.
 */

/** Sample standard deviation (n-1 denominator, the standard convention for
 * a return series estimated from a finite sample rather than a full
 * population). Returns 0 for fewer than 2 values. */
function rankSampleStdDev_(values) {
  if (values.length < 2) return 0;
  const mean = values.reduce((s, v) => s + v, 0) / values.length;
  const variance = values.reduce((s, v) => s + (v - mean) * (v - mean), 0) / (values.length - 1);
  return Math.sqrt(variance);
}

/**
 * Period return (%) and the sample stdDev (%) of daily returns within that
 * SAME period, from a closes array (oldest first) and how many trading days
 * back the period starts. Returns null if there isn't enough history yet
 * (a recent listing, or the fetch came back short) - the caller excludes
 * that symbol from ranking rather than computing off a too-short window.
 * score is null (not an astronomically large number) when stdDev is below
 * MOMENTUM_CONFIG.rankMinDailyStdDevPct - see that config comment for why a
 * near-zero denominator needs a floor, not just a not-exactly-zero check.
 */
function rankComputeReturnAndVol_(closes, tradingDaysBack) {
  if (closes.length < tradingDaysBack + 1) return null;
  const window = closes.slice(closes.length - tradingDaysBack - 1);
  const startPrice = window[0];
  const endPrice = window[window.length - 1];
  if (!(startPrice > 0)) return null;

  const returnPct = ((endPrice - startPrice) / startPrice) * 100;
  const dailyReturns = [];
  for (let i = 1; i < window.length; i++) {
    if (window[i - 1] > 0) dailyReturns.push(((window[i] - window[i - 1]) / window[i - 1]) * 100);
  }
  const stdDev = rankSampleStdDev_(dailyReturns);
  const score = stdDev >= MOMENTUM_CONFIG.rankMinDailyStdDevPct ? returnPct / stdDev : null;
  return { returnPct, stdDev, score };
}

/** BUY in the top rankBuyThreshold, SELL below rankSellThreshold, blank in
 * the middle zone - no held/hysteresis state, a pure read of where this
 * table's own rank currently sits. null rank (unranked - insufficient
 * history/fetch failure/degenerate volatility) is always blank. */
function rankComputeZoneAction_(rank, cfg) {
  if (rank == null) return '';
  if (rank <= cfg.rankBuyThreshold) return 'BUY';
  if (rank > cfg.rankSellThreshold) return 'SELL';
  return '';
}

/**
 * One table's return/stdDev/score pair for one symbol, from its closes
 * array and the two window lengths (trading days) that table uses - shared
 * by both the Long (6M/12M) and Short (1M/3M) tables, which differ only in
 * which two windows they use. Returns { returnA, stdDevA, scoreA, returnB,
 * stdDevB, scoreB, momentumScore } on success, or { failReason } if there
 * isn't enough history for the LONGER of the two windows, or either
 * window's volatility is too near zero to trust.
 */
function rankComputeTableEntry_(closes, windowADays, windowBDays) {
  const a = rankComputeReturnAndVol_(closes, windowADays);
  const b = rankComputeReturnAndVol_(closes, windowBDays);
  if (!a || !b) {
    return { failReason: 'Insufficient history for a full ' + Math.max(windowADays, windowBDays) + '-trading-day lookback' };
  }
  if (a.score == null || b.score == null) {
    return { failReason: 'Near-zero daily-return volatility in one of this table\'s lookback windows (likely a stale/illiquid price feed) - score undefined' };
  }
  return {
    returnA: a.returnPct, stdDevA: a.stdDev, scoreA: a.score,
    returnB: b.returnPct, stdDevB: b.stdDev, scoreB: b.score,
    momentumScore: (a.score + b.score) / 2
  };
}

/**
 * Scores one symbol into one table's running accumulator bucket ({ scored,
 * unranked }) - a fetch failure or this table's own insufficient-history/
 * degenerate-volatility check lands it in unranked with a Notes reason
 * instead of scored. Mutates acc[tableKey] in place.
 */
function rankScoreSymbolIntoAccumulator_(acc, tableKey, symbol, fetched, windowADays, windowBDays) {
  const bucket = acc[tableKey];
  if (!fetched || fetched.error) {
    bucket.unranked.push({ symbol, price: '', notes: 'Fetch failed: ' + (fetched ? fetched.error : 'no data') });
    return;
  }
  const closes = fetched.hist.map(r => r[4]);
  const price = closes[closes.length - 1];
  const entry = rankComputeTableEntry_(closes, windowADays, windowBDays);
  if (entry.failReason) {
    bucket.unranked.push({ symbol, price, notes: entry.failReason });
    return;
  }
  bucket.scored.push(Object.assign({ symbol, price }, entry));
}

/**
 * Turns one table's finished accumulator bucket into sorted, Rank/Action-
 * assigned rows ready to write (12 columns: Symbol, Price, ReturnA,
 * StdDevA, ScoreA, ReturnB, StdDevB, ScoreB, MomentumScore, Rank, Action,
 * Notes) - only called once every symbol has been scored (rankRunBatch's
 * finish path), since Rank needs the full sorted set.
 */
function rankFinalizeTableRows_(bucket, cfg) {
  const scored = bucket.scored.slice().sort((a, b) => b.momentumScore - a.momentumScore);

  const rows = scored.map((s, i) => {
    const rank = i + 1;
    return [
      s.symbol, s.price, s.returnA, s.stdDevA, s.scoreA, s.returnB, s.stdDevB, s.scoreB,
      s.momentumScore, rank, rankComputeZoneAction_(rank, cfg), ''
    ];
  });
  bucket.unranked.forEach(u => {
    rows.push([u.symbol, u.price, '', '', '', '', '', '', '', '', '', u.notes]);
  });

  return { rows, rankedCount: scored.length, unrankedCount: bucket.unranked.length };
}

/** Writes both tables side by side on one sheet (Long starting at column A,
 * a 1-column gap, then Short) - fully clears the sheet first since neither
 * table carries any manual/persisted state across runs. Column widths are
 * derived from the header arrays, not hardcoded, so reordering/resizing
 * either table's columns in config.gs doesn't require touching this. */
function rankWriteTwoTables_(longResult, shortResult) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  let sheet = ss.getSheetByName(MOMENTUM_CONFIG.rankPlanSheetName);
  if (!sheet) sheet = ss.insertSheet(MOMENTUM_CONFIG.rankPlanSheetName);
  sheet.clearContents();

  const longStartCol = 1;
  const shortStartCol = longStartCol + LONG_RANK_TABLE_HEADERS.length + MOMENTUM_CONFIG.rankTableGapCols;

  sheet.getRange(1, longStartCol, 1, LONG_RANK_TABLE_HEADERS.length).setValues([LONG_RANK_TABLE_HEADERS]);
  if (longResult.rows.length) {
    sheet.getRange(2, longStartCol, longResult.rows.length, LONG_RANK_TABLE_HEADERS.length).setValues(longResult.rows);
  }

  sheet.getRange(1, shortStartCol, 1, SHORT_RANK_TABLE_HEADERS.length).setValues([SHORT_RANK_TABLE_HEADERS]);
  if (shortResult.rows.length) {
    sheet.getRange(2, shortStartCol, shortResult.rows.length, SHORT_RANK_TABLE_HEADERS.length).setValues(shortResult.rows);
  }

  sheet.setFrozenRows(1);
  return sheet;
}

// --- Batch run state (PropertiesService) + accumulator cache (CacheService) ---

function rankStateGet_() {
  const props = PropertiesService.getScriptProperties();
  return {
    nextIndex: parseInt(props.getProperty(MOMENTUM_CONFIG.rankProps.nextIndex) || '0', 10),
    running: props.getProperty(MOMENTUM_CONFIG.rankProps.running) === 'true'
  };
}

function rankStateSetNextIndex_(nextIndex) {
  const props = PropertiesService.getScriptProperties();
  props.setProperty(MOMENTUM_CONFIG.rankProps.nextIndex, String(nextIndex));
  props.setProperty(MOMENTUM_CONFIG.rankProps.lastHeartbeat, new Date().toISOString());
}

function rankStateMarkRunning_(flag) {
  const props = PropertiesService.getScriptProperties();
  props.setProperty(MOMENTUM_CONFIG.rankProps.running, flag ? 'true' : 'false');
  props.setProperty(MOMENTUM_CONFIG.rankProps.lastHeartbeat, new Date().toISOString());
}

/** Starts a fresh run: resets progress to symbol 0 and clears any
 * in-progress accumulators from a prior run - mirrors taStateInitRun's
 * always-restart-from-scratch semantics (see config.gs's rankProps
 * comment for why no resume-in-place/staleness handling is needed here). */
function rankStateInitRun_() {
  const props = PropertiesService.getScriptProperties();
  props.setProperty(MOMENTUM_CONFIG.rankProps.nextIndex, '0');
  props.setProperty(MOMENTUM_CONFIG.rankProps.running, 'true');
  props.setProperty(MOMENTUM_CONFIG.rankProps.startedAt, new Date().toISOString());
  props.setProperty(MOMENTUM_CONFIG.rankProps.lastHeartbeat, new Date().toISOString());
  rankCacheSaveAccumulators_(rankEmptyAccumulators_());
}

function rankFinishRun_() {
  triggerDeleteByHandler_(MOMENTUM_CONFIG.rankWorkerHandler);
  rankStateMarkRunning_(false);
}

function rankEmptyAccumulators_() {
  return {
    long: { scored: [], unranked: [] },
    short: { scored: [], unranked: [] }
  };
}

function rankCacheSaveAccumulators_(acc) {
  CacheService.getScriptCache().put(MOMENTUM_CONFIG.rankCacheKey, JSON.stringify(acc), MOMENTUM_CONFIG.rankCacheTtlSeconds);
}

function rankCacheLoadAccumulators_() {
  const raw = CacheService.getScriptCache().get(MOMENTUM_CONFIG.rankCacheKey);
  return raw ? JSON.parse(raw) : rankEmptyAccumulators_();
}

/** Creates the one-shot trigger that fires the next rankRunBatch execution -
 * same shape as ta_batch_service.gs's taCreateWorkerTrigger_ (reuses
 * taTriggerDelayMs rather than a separate rank-specific delay constant). */
function rankCreateWorkerTrigger_(nextIndex) {
  triggerDeleteByHandler_(MOMENTUM_CONFIG.rankWorkerHandler);
  ScriptApp.newTrigger(MOMENTUM_CONFIG.rankWorkerHandler)
    .timeBased()
    .after(MOMENTUM_CONFIG.taTriggerDelayMs)
    .create();
  debugLog_('RANK_WORKER_TRIGGER_CREATED', nextIndex, 'Worker scheduled');
}

/**
 * The worker: processes symbols in parallel-fetch waves (same
 * taFetchChunkSize/taHardCapMs/taInitialWaveReserveMs time-budget check as
 * ta_batch_service.gs's taRunBatch - see config.gs's rankProps comment for
 * why the same tuned constants are reused rather than duplicated), scoring
 * each symbol into both tables' accumulators as it goes. Hands off to a
 * fresh trigger if time runs out before every symbol is scored; once the
 * last symbol is scored, sorts/ranks/writes both tables and finishes the
 * run.
 */
function rankRunBatch() {
  const lock = LockService.getScriptLock();
  if (!lock.tryLock(5000)) return;

  try {
    triggerDeleteByHandler_(MOMENTUM_CONFIG.rankWorkerHandler);

    const ctx = rankStateGet_();
    if (!ctx.running) {
      debugLog_('RANK_WORKER_SKIPPED', ctx.nextIndex, 'Run not active');
      return;
    }

    const symbols = readTechnicalAnalysisSymbols_();
    const total = symbols.length;

    if (total === 0) {
      debugLog_('RANK_NO_DATA', '', 'No symbols to process');
      rankFinishRun_();
      return;
    }

    const nextIndex = ctx.nextIndex || 0;
    if (nextIndex >= total) {
      debugLog_('RANK_ALREADY_COMPLETE', nextIndex, 'No remaining symbols');
      rankFinishRun_();
      return;
    }

    const startTime = Date.now();
    debugLog_('RANK_WORKER_BEGIN', nextIndex, 'Starting from symbol ' + (nextIndex + 1) + ' of ' + total);

    const acc = rankCacheLoadAccumulators_();
    let cursor = nextIndex;
    let maxWaveMs = MOMENTUM_CONFIG.taInitialWaveReserveMs;

    while (cursor < total) {
      const elapsedMs = Date.now() - startTime;
      if (elapsedMs + maxWaveMs > MOMENTUM_CONFIG.taHardCapMs) {
        debugLog_('RANK_TIME_BUDGET_HIT', cursor, Math.round(elapsedMs / 1000) + 's elapsed, ' + (total - cursor) + ' symbols left for next execution');
        break;
      }

      const waveEnd = Math.min(total, cursor + MOMENTUM_CONFIG.taFetchChunkSize);
      const waveSymbols = symbols.slice(cursor, waveEnd);

      const waveStart = Date.now();
      const histResults = fetchHistoricalBatch_(waveSymbols, MOMENTUM_CONFIG.rankHistoryRange);
      const waveDurationMs = Date.now() - waveStart;
      maxWaveMs = Math.max(maxWaveMs, waveDurationMs);
      const waveErrorCount = Object.keys(histResults).filter(s => histResults[s].error).length;
      debugLog_('RANK_FETCH_WAVE', cursor, waveSymbols.length + ' symbols, ' + waveErrorCount + ' failed, ' + waveDurationMs + 'ms');

      waveSymbols.forEach(symbol => {
        const fetched = histResults[symbol];
        rankScoreSymbolIntoAccumulator_(acc, 'long', symbol, fetched,
          MOMENTUM_CONFIG.rank6MonthTradingDays, MOMENTUM_CONFIG.rank12MonthTradingDays);
        rankScoreSymbolIntoAccumulator_(acc, 'short', symbol, fetched,
          MOMENTUM_CONFIG.rank1MonthTradingDays, MOMENTUM_CONFIG.rank3MonthTradingDays);
      });

      cursor = waveEnd;
    }

    rankCacheSaveAccumulators_(acc);
    rankStateSetNextIndex_(cursor);

    debugLog_('RANK_WORKER_END', cursor, 'Scored up to symbol ' + cursor + ' of ' + total + ' in ' + Math.round((Date.now() - startTime) / 1000) + 's');

    if (cursor >= total) {
      const longResult = rankFinalizeTableRows_(acc.long, MOMENTUM_CONFIG);
      const shortResult = rankFinalizeTableRows_(acc.short, MOMENTUM_CONFIG);
      rankWriteTwoTables_(longResult, shortResult);
      rankFinishRun_();

      const summary = `Long: ${longResult.rankedCount} ranked/${longResult.unrankedCount} skipped. ` +
        `Short: ${shortResult.rankedCount} ranked/${shortResult.unrankedCount} skipped.`;
      debugLog_('MOMENTUM_RANK_PLAN_DONE', cursor, summary);
      momentumToast_(summary, 'Momentum');
      return;
    }

    rankCreateWorkerTrigger_(cursor);
  } catch (err) {
    debugLog_('RANK_WORKER_ERROR', '', err.message);
    throw err;
  } finally {
    lock.releaseLock();
  }
}

/**
 * Starts a Momentum Rank Plan run: resets progress/accumulators and
 * schedules the first worker trigger, then returns immediately - does NOT
 * block until the tables are written (see this file's module docstring for
 * why). Called from RUN_BUILD_MOMENTUM_RANK_PLAN (Code.gs), same
 * start/log/toast/schedule shape as RUN_START_TECHNICAL_ANALYSIS.
 */
function START_MOMENTUM_RANK_PLAN() {
  triggerDeleteByHandler_(MOMENTUM_CONFIG.rankWorkerHandler);

  const symbols = readTechnicalAnalysisSymbols_();
  if (!symbols.length) {
    throw new Error('No symbols in Technical-Analysis!A2:A to rank.');
  }

  rankStateInitRun_();
  debugLog_('MOMENTUM_RANK_PLAN_START', 0, 'Starting Momentum Rank Plan for ' + symbols.length + ' symbols (batched - see Momentum-Log for progress)');
  momentumToast_('Momentum Rank Plan started - check Momentum-Log for progress', 'Momentum');

  rankCreateWorkerTrigger_(0);
}
